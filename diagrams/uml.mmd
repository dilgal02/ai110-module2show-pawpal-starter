classDiagram
    %% PawPal+ initial design (draft). Keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~Pet~ pets
        +list~Task~ tasks
        +add_pet(Pet pet)
        +add_task(Task task)
        +edit_task(str pet_name, str title, dict changes)
    }

    class Pet {
        +str name
        +str species
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +Optional~str~ preferred_time
        +Pet pet
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +sort_tasks(list~Task~ tasks) list~Task~
        +order_by_preferred_time(list~Task~ tasks) list~Task~
        +build_plan() DailyPlan
    }

    %% scheduled = (Task, start_time, end_time, reason); skipped = (Task, reason)
    class DailyPlan {
        +time day_start
        +int available_minutes
        +list~tuple~ scheduled
        +list~tuple~ skipped
        +add_entry(Task task, time start, str reason)
        +skip(Task task, str reason)
        +total_minutes() int
        +explain() str
        +to_table() list~dict~
    }

    Owner "1" o-- "0..*" Pet : owns
    Owner "1" *-- "0..*" Task : tracks
    Task "0..*" --> "1" Pet : for
    Scheduler --> "1" Owner : plans for
    Scheduler ..> DailyPlan : creates
    DailyPlan --> "0..*" Task : lists
